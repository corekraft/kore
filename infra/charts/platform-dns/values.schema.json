{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["zone", "image", "answer", "service", "gateway"],
  "additionalProperties": false,
  "properties": {
    "features": { "type": "object" },
    "zone": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "gateway": {
      "description": "The platform Gateway whose Service the zone is rewritten to inside the cluster; kore passes the environment's own (ADR 0132).",
      "type": "object",
      "required": ["name", "namespace"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 }
      }
    },
    "guaranteed": {
      "description": "The CPU and memory the container requests and limits, equal, while data-path-guaranteed-qos is on (ADR 0152, issue 1593).",
      "type": "object",
      "required": ["cpu", "memory"],
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodePort": {
          "type": ["integer", "null"],
          "minimum": 30000,
          "maximum": 32767
        }
      }
    },
    "answer": {
      "type": "object",
      "required": ["address", "ttl"],
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "format": "ipv4" },
        "ttl": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
