{
  "uid": "kore-service-__SERVICE__",
  "title": "Service __SERVICE__",
  "tags": ["kore", "service"],
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Available replicas",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "kore:namespace_available_replicas{namespace=\"__NAMESPACE__\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "kore:namespace_requests_increase5m{namespace=\"__NAMESPACE__\"} / 300"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Server error ratio",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "kore:namespace_error_ratio_5m{namespace=\"__NAMESPACE__\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Container restarts",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "kore:namespace_restarts_increase15m{namespace=\"__NAMESPACE__\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "{k8s_namespace_name=\"__NAMESPACE__\"}" }
      ]
    }
  ]
}
