{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "type": "string",
      "maxLength": 61,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "not": { "pattern": "--" }
    },
    "services": {
      "description": "Registered Service names: a single DNS label without a double hyphen, as the Service API requires (ADR 0115).",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 61,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "not": { "pattern": "--" }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destination": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
        }
      }
    }
  }
}
