{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["platformDomain", "backstage", "proxy"],
  "additionalProperties": false,
  "properties": {
    "platformDomain": {
      "description": "The environment's platform domain (ADR 0042). Backstage is served at backstage.<platformDomain> and signs in against keycloak.<platformDomain> (ADR 0113).",
      "type": "string",
      "maxLength": 180,
      "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*Gi$"
        },
        "compatibilityVersion": {
          "type": "integer",
          "enum": [16, 17, 18]
        }
      }
    },
    "backstage": {
      "type": "object",
      "required": ["image"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "The Backstage image, by digest.",
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "proxy": {
      "type": "object",
      "required": ["image"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "The sign-in proxy image, by digest.",
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
