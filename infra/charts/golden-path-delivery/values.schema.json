{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["repoURL", "revision", "environment", "templateImages"],
  "additionalProperties": false,
  "properties": {
    "repoURL": { "type": "string", "pattern": "^https://.+" },
    "revision": {
      "description": "A full commit sha, never a branch or tag, so the sync follows a reviewed commit.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,59}[a-z0-9])?$"
    },
    "registrationsPath": { "type": "string", "minLength": 1 },
    "workloadPath": { "type": "string", "minLength": 1 },
    "namespace": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "templateImages": {
      "type": "object",
      "required": ["static-frontend", "kotlin-bff"],
      "additionalProperties": false,
      "properties": {
        "static-frontend": { "$ref": "#/definitions/entry" },
        "kotlin-bff": { "$ref": "#/definitions/entry" }
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["image", "digest"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[^@:\\s]+(:[0-9]+)?(/[^@:\\s]+)*$"
        },
        "digest": {
          "description": "The signed sha256 digest recorded in the template lock.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signer": { "type": "string" }
      }
    }
  }
}
