{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["service", "frontend", "bff"],
  "additionalProperties": false,
  "properties": {
    "service": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "frontend": {
      "$ref": "#/definitions/workload"
    },
    "bff": {
      "$ref": "#/definitions/workload"
    },
    "ingress": {
      "description": "Set by the ApplicationSet from the Service's default host (ADR 0042); without it no ingress resource renders.",
      "type": "object",
      "required": ["host", "gatewayClassName"],
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "gatewayClassName": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "required": ["image"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "An image reference that carries its sha256 digest; a tag alone is refused.",
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
