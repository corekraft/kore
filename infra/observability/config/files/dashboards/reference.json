{
  "title": "Kore Reference",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests",
      "targets": [
        {
          "expr": "sum by (service_name, http_route) (rate(http_server_request_count_total[5m]))",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "logs",
      "title": "Reference logs",
      "targets": [
        {
          "expr": "{service_name=~\"reference-.*\"}",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ],
      "datasource": { "type": "loki", "uid": "loki" }
    },
    {
      "type": "traces",
      "title": "Reference traces",
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ .service.name =~ `reference-.*` }",
          "datasource": { "type": "tempo", "uid": "tempo" }
        }
      ],
      "datasource": { "type": "tempo", "uid": "tempo" }
    }
  ]
}
