#!/usr/sbin/nft -f
# Managed by infra/hosts/vps (Ansible). Edits here are overwritten.
#
# This file owns the kore_host table only. It never flushes the ruleset, so the
# tables Tailscale, Incus and k3s manage survive a reload. Forwarding is left
# to those owners, except for the node-port drop below, which only ever removes
# traffic from the forward path; this table filters traffic addressed to the
# host itself.
#
# The port table (port-table.yaml) and the host's own addresses are the only
# inputs for ports and addresses. The node-port range is k3s's default.
{% set external_node_ports = network_port_table.publish | selectattr('service', 'equalto', 'kore-gateway-external') | map(attribute='nodePort') | unique | list %}
table inet kore_host
delete table inet kore_host

table inet kore_host {
  # Standard ports to node ports, per address. It runs before kube-proxy's own
  # node-port rules (priority -100), so a redirected packet reaches the Service.
  chain prerouting {
    type nat hook prerouting priority -110; policy accept;

{% for rule in network_port_table.publish %}
    ip daddr {{ kore_host_addresses[rule.address] }} {{ rule.protocol }} dport {{ rule.port }} redirect to :{{ rule.nodePort }}
{% endfor %}
  }

  chain input {
    type filter hook input priority filter; policy drop;

    iif "lo" accept
    ct state established,related accept
    ct state invalid drop

    # Everything on the tailnet, including SSH, reaches the host.
    iifname "tailscale0" accept

    # Tailscale's direct WireGuard path.
    udp dport 41641 accept

    # Diagnostics, path MTU discovery and IPv6 neighbour discovery.
    meta l4proto icmp accept
    meta l4proto ipv6-icmp accept

    # Incus VMs on the private bridge get DHCP and DNS from the host, and
    # nothing else on it.
    iifname "incusbr0" udp dport { 53, 67 } accept
    iifname "incusbr0" tcp dport 53 accept

    # k3s pods reach the API server, kubelet and node-local services through
    # the CNI bridge. Pods are the cluster's own workloads, not the internet.
    iifname "cni0" accept

    # DHCP and DHCPv6 replies to the host's own lease requests.
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept
  }

  # A node port is reached by forwarding, after kube-proxy's translation, so the
  # input chain never sees it. The original tuple still carries the node port.
  # Off the tailnet, every node port is dropped except the external Gateway's,
  # which the port table publishes on the public address. This includes a pod
  # or VM that reaches a node port through a host address. The policy stays
  # accept, so all other forwarding is left to the CNI and Incus.
  chain forward {
    type filter hook forward priority filter; policy accept;

    iifname "tailscale0" accept
    iifname != "tailscale0" meta l4proto { tcp, udp } ct original proto-dst 30000-32767 ct original proto-dst != { {{ external_node_ports | join(', ') }} } drop
  }
}
