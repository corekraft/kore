{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["components"],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "phase",
          "namespace",
          "kind",
          "version",
          "dependencies",
          "timeout",
          "readiness",
          "ownsCRDs"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "phase": {
            "enum": [
              "bootstrap",
              "core",
              "observability",
              "configuration",
              "enforcement"
            ]
          },
          "namespace": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["helm", "local-chart", "manifest"] },
          "featureFlag": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "A flag in the environment overlay's features map; the component is installed only when it is true."
          },
          "ownsCRDGroups": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "timeout": { "type": "string", "pattern": "^[0-9]+[smh]$" },
          "readiness": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "helm": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "forceConflicts": { "type": "boolean" },
              "wait": { "const": false },
              "reason": { "type": "string", "minLength": 1 }
            },
            "if": {
              "anyOf": [
                {
                  "required": ["forceConflicts"],
                  "properties": { "forceConflicts": { "const": true } }
                },
                { "required": ["wait"] }
              ]
            },
            "then": { "required": ["reason"] }
          }
        }
      }
    }
  }
}
