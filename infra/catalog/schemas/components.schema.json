{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["components"],
  "$defs": {
    "probeFields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 1 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "phase",
          "namespace",
          "kind",
          "version",
          "dependencies",
          "timeout",
          "readiness",
          "ownsCRDs"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "phase": {
            "enum": [
              "bootstrap",
              "core",
              "observability",
              "configuration",
              "enforcement"
            ]
          },
          "namespace": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["helm", "local-chart", "manifest"] },
          "ownsCRDGroups": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "timeout": { "type": "string", "pattern": "^[0-9]+[smh]$" },
          "readiness": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "reason", "probes"],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "object",
                  "required": ["kind", "name", "container"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": ["Deployment", "StatefulSet", "DaemonSet"]
                    },
                    "name": { "type": "string", "minLength": 1 },
                    "container": { "type": "string", "minLength": 1 }
                  }
                },
                "reason": { "type": "string", "minLength": 1 },
                "probes": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "livenessProbe": { "$ref": "#/$defs/probeFields" },
                    "readinessProbe": { "$ref": "#/$defs/probeFields" },
                    "startupProbe": { "$ref": "#/$defs/probeFields" }
                  }
                }
              }
            }
          },
          "helm": {
            "type": "object",
            "required": ["forceConflicts"],
            "additionalProperties": false,
            "properties": {
              "forceConflicts": { "type": "boolean" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "if": { "properties": { "forceConflicts": { "const": true } } },
            "then": { "required": ["reason"] }
          }
        }
      }
    }
  }
}
