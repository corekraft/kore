{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["seeds"],
  "properties": {
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "image",
          "catalogImage",
          "component",
          "reason",
          "evidence"
        ],
        "properties": {
          "image": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" },
          "catalogImage": { "type": "string", "minLength": 1 },
          "component": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "required": ["method", "source", "checked", "provenance"],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "checked": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "provenance": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["signed"],
                    "properties": { "signed": { "const": false } },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["signed", "issuer", "identity"],
                    "properties": {
                      "signed": { "const": true },
                      "issuer": { "type": "string", "pattern": "^https://" },
                      "identity": { "type": "string", "pattern": "^https://" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
