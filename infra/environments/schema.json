{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "provider", "kubeContext", "cluster", "registry"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "provider": { "enum": ["minikube", "managed"] },
    "kubeContext": { "type": "string", "minLength": 1 },
    "cluster": {
      "type": "object",
      "required": [
        "profile",
        "kubernetesVersion",
        "driver",
        "containerRuntime",
        "cpus",
        "memoryMB",
        "diskSize"
      ],
      "properties": {
        "serviceCidr": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$"
        },
        "cpus": { "type": "integer", "minimum": 2 },
        "memoryMB": { "type": "integer", "minimum": 4096 }
      }
    },
    "registry": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:\\d{1,5})?$"
        }
      }
    },
    "componentValues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": true
}
