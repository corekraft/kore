{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "provider", "kubeContext", "registry"],
  "allOf": [
    {
      "if": { "properties": { "provider": { "const": "k3d" } } },
      "then": { "required": ["k3d"], "not": { "required": ["cluster"] } },
      "else": { "required": ["cluster"], "not": { "required": ["k3d"] } }
    }
  ],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "provider": { "enum": ["k3d", "minikube", "managed"] },
    "kubeContext": { "type": "string", "minLength": 1 },
    "cluster": {
      "type": "object",
      "required": [
        "profile",
        "kubernetesVersion",
        "driver",
        "containerRuntime",
        "cpus",
        "memoryMB",
        "diskSize"
      ],
      "properties": {
        "serviceCidr": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$"
        },
        "cpus": { "type": "integer", "minimum": 2 },
        "memoryMB": { "type": "integer", "minimum": 4096 }
      }
    },
    "k3d": {
      "type": "object",
      "description": "The k3d cluster (provider k3d only). The k3s image resolves from versions.images.k3s and the kubeContext must be k3d-<clusterName>.",
      "required": ["clusterName", "serviceCidr", "ports"],
      "additionalProperties": false,
      "properties": {
        "clusterName": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "serviceCidr": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["hostPort", "loadBalancerPort"],
            "additionalProperties": false,
            "properties": {
              "hostPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "loadBalancerPort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "servers": { "type": "integer", "minimum": 1, "default": 1 },
        "agents": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "registry": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:\\d{1,5})?$"
        }
      }
    },
    "platformMirror": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:\\d{1,5})?(/[a-z0-9._-]+)+$"
    },
    "imageInventory": {
      "enum": ["audit", "enforce"],
      "description": "Inventory mode and enrollment rule (ADR 0056): enforce labels every catalog platform namespace except enrollmentExemptions with policy.sigstore.dev/include before the inventory runs; audit labels none."
    },
    "enrollmentExemptions": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "features": {
      "type": "object",
      "description": "Feature flags (ADR 0077): flag name to boolean, off unless true. Passed into local chart values as features.<name>.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "type": "boolean" }
    },
    "componentSources": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "componentValues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": true
}
