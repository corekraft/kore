#!/usr/bin/env sh

repo_root="$(git rev-parse --show-toplevel)"
. "$repo_root/tools/kore/.husky/pinned.sh"
pinned "$repo_root/tools/kore/node_modules/.bin/lint-staged" \
  --config "$repo_root/tools/kore/lint-staged.config.js" || exit 1

staged="$(git diff --cached --name-only)"

# A staged tree whose tests already passed (recorded by `harness test record`,
# under the main checkout's .kore/state/test-pass) runs none again, here or in
# any worktree; any change to the staged tree is a different tree hash. A failed
# or missing check just means the tests run. CI `check` still runs every suite.
# The check runs once, and only when a test step could run.
skip_tests=""
tests_checked=""
tests_ran=""
already_passed() {
  if [ -z "$tests_checked" ]; then
    tests_checked=1
    if pinned node "$repo_root/skills/bin/harness.mjs" test check </dev/null 2>/dev/null; then
      skip_tests=1
      echo "pre-commit: skipping the related tests; they already passed for this staged tree" >&2
    fi
  fi
  [ -n "$skip_tests" ]
}

if printf '%s\n' "$staged" | grep -qE '^(\.claude|\.codex|skills)/'; then
  if ! already_passed; then
    tests_ran=1
    (cd "$repo_root/tools/harness" && pinned node "$repo_root/tools/kore/.husky/test-lock.mjs" npm run test:hooks --silent) || {
      echo "pre-commit: hook tests failed; run 'mise run test-hooks' and fix them" >&2
      exit 1
    }
  fi
  pinned node "$repo_root/skills/bin/harness.mjs" hook skill-links --strict </dev/null || {
    echo "pre-commit: skill links are wrong; run 'node skills/bin/harness.mjs hook skill-links --strict' and fix them" >&2
    exit 1
  }
fi

# The signer guard reads every workflow, so check it when a workflow changes too.
if printf '%s\n' "$staged" | grep -qE '^(\.github/workflows|\.claude|\.codex|skills)/'; then
  pinned node "$repo_root/skills/bin/harness.mjs" hook workflow-permissions --strict </dev/null || {
    echo "pre-commit: workflow permissions are wrong; run 'node skills/bin/harness.mjs hook workflow-permissions --strict' and fix them" >&2
    exit 1
  }
fi

# The SAST rules (scan-sast) run on staged source only, so a finding such as
# kore-dynamic-regexp fails here, with its rule and line, instead of in CI.
# Semgrep reads each file as it is on disk, so a partly staged file is scanned
# with its unstaged edits too. The grep skips even starting node when no staged path could qualify.
sast_files=""
if printf '%s\n' "$staged" | grep -qE '^(tools/kore/src/|tools/harness/src/|apps/|\.claude/).*\.(ts|mjs|js)$'; then
  sast_files="$(printf '%s\n' "$staged" | pinned node "$repo_root/tools/kore/.husky/sast-staged.mjs")" || {
    echo "pre-commit: could not select the staged files for SAST; run 'mise run scan-sast' and fix the error" >&2
    exit 1
  }
fi
if [ -n "$sast_files" ]; then
  # A missing semgrep must not read as a finding.
  pinned semgrep --version >/dev/null 2>&1 || {
    echo "pre-commit: semgrep is missing; run 'mise install'" >&2
    exit 1
  }
  # shellcheck disable=SC2086
  (cd "$repo_root" && IFS='
' && set -f && pinned semgrep scan --metrics=off --disable-version-check --quiet --config infra/policies/semgrep/kore-node.yaml --error $sast_files) || {
    echo "pre-commit: SAST found a problem in the staged files; run 'mise run scan-sast' and fix it" >&2
    exit 1
  }
fi

# Every test run below goes through test-lock.mjs: a host-wide semaphore under
# the main checkout's .kore/state, sized to the cores and load, so commits in
# many worktrees share the cores instead of multiplying vitest workers beside a
# live cluster.

# The kore specs read the CLI source and config (tools/kore/), and the files the
# repository specs scan or render: infra/ (apis, catalog, charts, environments,
# observability, policies, tofu) and apps/. infra/plans is prose no spec reads.
# Only the specs related to the staged files run here; related-tests.mjs picks
# them, and the full suite with coverage runs in CI before merge.
if printf '%s\n' "$staged" |
  grep -qE '^(tools/kore/|apps/|infra/(apis|catalog|charts|environments|observability|policies|tofu)/)'; then
  (cd "$repo_root/tools/kore" && pinned npm run check --silent) || {
    echo "pre-commit: typecheck failed; run 'npm run check' in tools/kore and fix the errors" >&2
    exit 1
  }
  plan="none"
  if ! already_passed; then
    plan="$(printf '%s\n' "$staged" | pinned node "$repo_root/tools/kore/.husky/related-tests.mjs" kore)" || exit 1
  fi
  related="$(printf '%s\n' "$plan" | sed 1d)"
  case "$(printf '%s\n' "$plan" | sed -n 1p)" in
  full)
    tests_ran=1
    (cd "$repo_root/tools/kore" && pinned node "$repo_root/tools/kore/.husky/test-lock.mjs" npm run test:unit --silent) || {
      echo "pre-commit: unit tests failed; run 'npm run test:unit' in tools/kore and fix them" >&2
      exit 1
    }
    ;;
  related)
    tests_ran=1
    # shellcheck disable=SC2086
    (cd "$repo_root/tools/kore" && IFS='
' && set -f && pinned node "$repo_root/tools/kore/.husky/test-lock.mjs" npm run test:related --silent -- $related) || {
      echo "pre-commit: related unit tests failed; run 'npm run test:related -- <files>' in tools/kore, or 'npm run test:unit' for all, and fix them" >&2
      exit 1
    }
    ;;
  esac
fi

# The harness has its own typecheck and tests; run them when its sources, tests,
# or config are staged.
if printf '%s\n' "$staged" | grep -qE '^tools/harness/'; then
  (cd "$repo_root/tools/harness" && pinned npm run check --silent) || {
    echo "pre-commit: harness typecheck failed; run 'npm run check' in tools/harness and fix the errors" >&2
    exit 1
  }
  plan="none"
  if ! already_passed; then
    plan="$(printf '%s\n' "$staged" | pinned node "$repo_root/tools/kore/.husky/related-tests.mjs" harness)" || exit 1
  fi
  related="$(printf '%s\n' "$plan" | sed 1d)"
  case "$(printf '%s\n' "$plan" | sed -n 1p)" in
  full)
    tests_ran=1
    (cd "$repo_root/tools/harness" && pinned node "$repo_root/tools/kore/.husky/test-lock.mjs" npm run test:unit --silent) || {
      echo "pre-commit: harness unit tests failed; run 'npm run test:unit' in tools/harness and fix them" >&2
      exit 1
    }
    ;;
  related)
    tests_ran=1
    # shellcheck disable=SC2086
    (cd "$repo_root/tools/harness" && IFS='
' && set -f && pinned node "$repo_root/tools/kore/.husky/test-lock.mjs" npm run test:related --silent -- $related) || {
      echo "pre-commit: harness related tests failed; run 'npm run test:related -- <files>' in tools/harness, or 'npm run test:unit' for all, and fix them" >&2
      exit 1
    }
    ;;
  esac
fi

# Every test step passed (a failure exits above), so record the staged tree.
# Recording is an optimization: a failure to record never fails the commit.
if [ -n "$tests_ran" ]; then
  pinned node "$repo_root/skills/bin/harness.mjs" test record </dev/null >/dev/null 2>&1 || true
fi
