{
  "name": "@corekraft/kore",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral local Kubernetes platform orchestration",
  "type": "module",
  "bin": {
    "kore": "dist/src/cli/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" package.json tsconfig.json .oxlintrc.json .prettierrc.json commitlint.config.js lint-staged.config.js",
    "format:check": "prettier --check \"src/**/*.ts\" package.json tsconfig.json .oxlintrc.json .prettierrc.json commitlint.config.js lint-staged.config.js",
    "lint": "oxlint --deny-warnings src/**/*.ts",
    "kore": "npm run build --silent && node dist/src/cli/cli.js",
    "test": "npm run build --silent && vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:opa": "opa test ../../infra/policies/opa/bundles/v1 -v",
    "test:unit": "vitest run",
    "test:integration": "npm run build --silent && KORE_RUN_INTEGRATION=1 node --test --test-concurrency=1 dist/src/cluster/*.integration.spec.js dist/src/platform/*.integration.spec.js",
    "prepare": "cd ../.. && husky tools/kore/.husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.8.2"
  }
}
