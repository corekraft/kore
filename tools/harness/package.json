{
  "name": "@corekraft/harness",
  "version": "0.1.0",
  "private": true,
  "description": "Agent harness tools: one bundled CLI that skills and hooks call",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"integration/**/*.ts\" package.json tsconfig.json .oxlintrc.json .prettierrc.json vitest.config.ts vitest.integration.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"integration/**/*.ts\" package.json tsconfig.json .oxlintrc.json .prettierrc.json vitest.config.ts vitest.integration.config.ts",
    "lint": "oxlint --type-aware --deny-warnings src tests integration",
    "test": "vitest run --coverage && npm run test:budget && npm run test:specs",
    "test:unit": "vitest run && npm run test:budget && npm run test:specs",
    "test:budget": "../../.claude/hooks/harness.sh hook test-budget --package tools/harness --report test-results/unit.json",
    "test:specs": "../../.claude/hooks/harness.sh hook unit-specs --package tools/harness",
    "test:related": "vitest related --run --passWithNoTests --maxWorkers=2",
    "test:hooks": "vitest run .claude/",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.8.2"
  }
}
