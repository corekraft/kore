{
  "permissions": {
    "allow": [
      "Bash(mise run test)",
      "Bash(mise run validate)",
      "Bash(mise run test-opa)",
      "Bash(mise run test-gatekeeper)",
      "Bash(mise run test-hooks)",
      "Bash(kore doctor:*)",
      "Bash(kore * status)",
      "Bash(kore * status *)",
      "Bash(./bin/kore doctor:*)",
      "Bash(./bin/kore * status)",
      "Bash(./bin/kore * status *)"
    ],
    "deny": [
      "Bash(k3d cluster delete:*)",
      "Bash(k3d * cluster delete*)",
      "Bash(k3d cluster * delete*)",
      "Bash(tofu destroy:*)",
      "Bash(terraform destroy:*)",
      "Bash(helm uninstall:*)",
      "Bash(kubectl delete namespace:*)",
      "Bash(kubectl delete ns:*)",
      "Bash(kore * destroy)",
      "Bash(kore * destroy *)",
      "Bash(./bin/kore * destroy)",
      "Bash(./bin/kore * destroy *)",
      "Read(./.kore/keys/**)",
      "Read(./.kore/state/*token*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/harness.sh\" hook context"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/harness.sh\" hook record session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/harness.sh\" hook delta"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/harness.sh\" hook guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/harness.sh\" hook feedback post-edit"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/harness.sh\" hook feedback tool-failure"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/harness.sh\" hook feedback stop"
          }
        ]
      }
    ]
  }
}
